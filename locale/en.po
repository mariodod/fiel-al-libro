#. TRANSLATORS: The companion, after picking the player up.
msgid "dia.quixote.chatter.revive"
msgstr "Get up, Sancho! I am here. It was nobody's fault."

#. TRANSLATORS: The companion, after picking the player up.
msgid "dia.sancho.chatter.revive"
msgstr "Get up, your lordship. Come now, there are still mills to see."

#. TRANSLATORS: The name of the light attack.
msgid "it.ability.attack_light.name"
msgstr "Light attack"

#. TRANSLATORS: The name of the heavy attack.
msgid "it.ability.attack_heavy.name"
msgstr "Heavy attack"

#. TRANSLATORS: The Examine prompt: what to press to look at a thing.
msgid "ui.examine.prompt"
msgstr "E — Examine"

#. TRANSLATORS: The Examine panel: the text written on the thing, in
#. quotation marks. Format: %s.
msgid "ui.examine.quote"
msgstr "“%s”"

# --- THE FACES: what a character perceives -------------------------------
# One face per truth, per object. The Examine panel shows ONE of them —
# the one the reader is reading right now — and never the other truth and
# never the other character's reading.
#
# The "tell" is the seam: the one detail that does not add up. It is the
# seed of the Lectura system (GDD.md §6), and it is the only thing the
# player is meant to notice without a marker.

#. TRANSLATORS: The rock in the Reality truth: how it looks.
msgid "ui.face.rock.reality.desc"
msgstr "A grey stone about the size of a fist, with dry lichen on the top and its base sunk into the earth."

#. TRANSLATORS: The rock in the Reality truth: the one detail that does not add up.
msgid "ui.face.rock.reality.tell"
msgstr "It is heavier than a stone that size should be."

#. TRANSLATORS: The rock in the Book truth: how it looks.
msgid "ui.face.rock.book.desc"
msgstr "A small book, bound in brown leather and tied with a strap. The edges of the leaves are gilt and they stain your fingers."

#. TRANSLATORS: The rock in the Book truth: the one detail that does not add up.
msgid "ui.face.rock.book.tell"
msgstr "It is heavier than a book that size should be."

#. TRANSLATORS: The title written on the cover of the book the rock is.
msgid "ui.face.rock.book.title"
msgstr "The Ingenious Gentleman Don Quixote of La Mancha"

#. TRANSLATORS: The windmill in the Reality truth: how it looks.
msgid "ui.face.windmill.reality.desc"
msgstr "A stone mill with its four sails spread and a low door, so worn that the hinge no longer fits."

#. TRANSLATORS: The windmill in the Reality truth: the one detail that does not add up.
msgid "ui.face.windmill.reality.tell"
msgstr "There is no wind at all, and yet the sails are turning."

#. TRANSLATORS: The windmill in the Book truth: how it looks.
msgid "ui.face.windmill.book.desc"
msgstr "A giant of the kind that stories are made of, with arms so long they brush the ground and a small head sunk between his shoulders."

#. TRANSLATORS: The windmill in the Book truth: the one detail that does not add up.
msgid "ui.face.windmill.book.tell"
msgstr "What looks like an arm on him is a mill's sail."

#. TRANSLATORS: The Reality layer: what actually happened.
msgid "ui.layer.reality"
msgstr "Reality"

#. TRANSLATORS: The Book layer: what the novel says.
msgid "ui.layer.book"
msgstr "Book"

#. TRANSLATORS: The word "on", for a switch.
msgid "ui.on"
msgstr "on"

#. TRANSLATORS: The word "off", for a switch.
msgid "ui.off"
msgstr "off"

#. TRANSLATORS: The lowest madness band: Lucid.
msgid "ui.locura.lucid"
msgstr "Lucid"

#. TRANSLATORS: Madness band 2: Displaced.
msgid "ui.locura.displaced"
msgstr "Displaced"

#. TRANSLATORS: Madness band 3: Lost.
msgid "ui.locura.lost"
msgstr "Lost"

#. TRANSLATORS: Madness band 4: Absorbed.
msgid "ui.locura.absorbed"
msgstr "Absorbed"

#. TRANSLATORS: What the windmill is called in the Reality layer.
msgid "ui.form.molino"
msgstr "windmill"

#. TRANSLATORS: What the windmill is called in the Book layer.
msgid "ui.form.gigante"
msgstr "giant"

#. TRANSLATORS: What the rock is called in the Reality layer.
msgid "ui.form.roca"
msgstr "rock"

#. TRANSLATORS: What the rock is called in the Book layer.
msgid "ui.form.libro"
msgstr "book"

#. TRANSLATORS: The windmill itself.
msgid "ui.object.molino"
msgstr "The windmill"

#. TRANSLATORS: The rock itself.
msgid "ui.object.roca"
msgstr "The rock"

#. TRANSLATORS: Floating tag over an object: who is looking, and what they see. Format: %s, %s.
msgid "ui.perception.tag"
msgstr "%s: %s"

#. TRANSLATORS: The Venture of Montiel, the first boss.
msgid "ui.venture.montiel"
msgstr "The mill of Montiel"

#. TRANSLATORS: The Venture in the Reality truth: how it looks.
msgid "ui.face.venture.reality.desc"
msgstr "The mill of Montiel, standing. The stone is polished smooth by the grain, and the low door stands wide open."

#. TRANSLATORS: The Venture in the Reality truth: the one detail that does not add up.
msgid "ui.face.venture.reality.tell"
msgstr "The sails turn towards wherever you are, and they do not turn slowly."

#. TRANSLATORS: The Venture in the Reality truth: the name the manuscript gives it.
msgid "ui.face.venture.reality.title"
msgstr "The mill of Montiel"

#. TRANSLATORS: The Venture in the Book truth: how it looks.
msgid "ui.face.venture.book.desc"
msgstr "The giant of the mills of Montiel, with arms long as sails and a small head sunk between its shoulders."

#. TRANSLATORS: The Venture in the Book truth: the one detail that does not add up.
msgid "ui.face.venture.book.tell"
msgstr "What looks like an arm on him is a mill sail, and what looks like a head is the millstone."

#. TRANSLATORS: The Venture in the Book truth: the name the manuscript gives it.
msgid "ui.face.venture.book.title"
msgstr "The giant of the mills of Montiel"

#. TRANSLATORS: The name of the guard.
msgid "it.ability.block.name"
msgstr "The guard"

#. TRANSLATORS: The name of a Venture's move, in the developer's readout.
msgid "ui.move.mill_sails.name"
msgstr "The sails"

#. TRANSLATORS: The name of a Venture's move, in the developer's readout.
msgid "ui.move.mill_topple.name"
msgstr "The topple"

#. TRANSLATORS: The name of a Venture's move, in the developer's readout.
msgid "ui.move.giant_sweep.name"
msgstr "The sweep"

#. TRANSLATORS: The name of a Venture's move, in the developer's readout.
msgid "ui.move.giant_slam.name"
msgstr "The slam"

