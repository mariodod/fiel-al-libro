msgid "ui.ending.el_manuscrito.name"
msgstr "The Manuscript"

msgid "ui.ending.el_manuscrito.desc"
msgstr "You are the reader. The game is the book."

msgid "ui.ending.la_locura_compartida.name"
msgstr "Shared Madness"

msgid "ui.ending.la_locura_compartida.desc"
msgstr "Both minds are gone. The world is the book."

msgid "ui.ending.el_mundo_real.name"
msgstr "The Real World"

msgid "ui.ending.el_mundo_real.desc"
msgstr "Both cured, the book shelved."

msgid "ui.ending.el_libro_gana.name"
msgstr "The Book Wins"

msgid "ui.ending.el_libro_gana.desc"
msgstr "Middle ground: the book prevails, partly."

#. TRANSLATORS: Shown when the Manifiesto reader has no collected fragments.
msgid "ui.manifiesto.empty"
msgstr "The shelf is empty."

#. TRANSLATORS: The manuscript prologue ï¿½ opening page before chapter 1.
msgid "prologue.opening.text"
msgstr "You are holding a book. It was written in 1605, and it has been waiting for you. The page you are about to read is not the first page ï¿½ it is the page the book opens to when you pick it up. Read it. Turn it. The world on the other side is not the world you left."

msgid "prologue.opening.reality"
msgstr "A man rides across the plain. The windmills are windmills. The inn is an inn."

msgid "prologue.opening.book"
msgstr "A knight rides across the plain. The windmills are giants. The inn is a castle."

#. TRANSLATORS: The clavilo (wooden horse) fragment title.
msgid "bk.ch38.clavilo.title"
msgstr "Clavilo"

#. TRANSLATORS: Shown when the player spots an anamorphosis in Lectura mode.
msgid "ui.slice.anamorphosis_spotted"
msgstr "Anamorphosis spotted"

#. TRANSLATORS: Shown when the player examines an anamorphosis object from the wrong vantage point in Lectura mode.
msgid "ui.slice.anamorphosis_wrong_spot"
msgstr "Not from here — move around the object."

#. TRANSLATORS: Shown when the player resolves an anamorphosis and gains evidence.
msgid "ui.slice.anamorphosis_resolved"
msgstr "Anamorphosis resolved ï¿½ +%d evidence"

#. TRANSLATORS: Shown when the player has enough evidence to use the Verdict.
msgid "ui.slice.verdict_ready"
msgstr "Enough evidence for a Verdict"








