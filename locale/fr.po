#. META: namespace=ui
msgid "ui.book.libro.don_juan.passive.name"
msgstr "The Inviter"

#. META: namespace=ui
msgid "ui.book.libro.don_juan.passive.desc"
msgstr "You lure enemies into the positions you want."

#. META: namespace=ui
msgid "ui.book.libro.don_juan.codex"
msgstr "The inviter is never late to his own dinner."

#. META: namespace=ui
msgid "ui.book.libro.codice.name"
msgstr "Codex — The Ingenious Gentleman"

#. META: namespace=ui
msgid "ui.book.libro.codice.desc"
msgstr "The book itself. The second part you write by reading it."

#. META: namespace=ui
msgid "ui.book.libro.codice.passive.name"
msgstr "The Verdict"

#. META: namespace=ui
msgid "ui.book.libro.codice.passive.desc"
msgstr "Every Venture admits a third resolution: the reader's."

#. META: namespace=ui
msgid "ui.book.libro.codice.codex"
