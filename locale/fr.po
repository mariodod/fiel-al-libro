#. META: namespace=ui
msgid "ui.book.libro.lazarillo.passive.name"
msgstr "The Vessel"

#. META: namespace=ui
msgid "ui.book.libro.lazarillo.passive.desc"
msgstr "More stamina: endure what others cannot."

#. META: namespace=ui
msgid "ui.book.libro.lazarillo.codex"
msgstr "Lazarillo keeps in his mouth what will not fit in his purse."

#. META: namespace=ui
msgid "ui.book.libro.tirant.name"
msgstr "Tirant lo Blanc"

#. META: namespace=ui
msgid "ui.book.libro.tirant.desc"
