#. META: namespace=ui
msgid "ui.book.libro.tablas.passive.desc"
msgstr "You sense a region's truth layer before entering it."

#. META: namespace=ui
msgid "ui.book.libro.tablas.codex"
msgstr "The wise king's sky does not lie about the book."

#. META: namespace=ui
msgid "ui.book.libro.buscon.name"
msgstr "The Swindler"

#. META: namespace=ui
msgid "ui.book.libro.buscon.desc"
