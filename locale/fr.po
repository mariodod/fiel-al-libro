# --- WEEK 1-2 GREY BOX (the vertical slice sandbox) -------------------------

#. TRANSLATORS: The title of the Week 1-2 grey box HUD.
msgid "ui.slice.title"
msgstr "FIEL AL LIVRE — boîte grise, semaines 1–2"

#. TRANSLATORS: HUD line: the truth the world is in. Format: %s.
msgid "ui.slice.line.world"
msgstr "Vérité du monde : %s"

#. TRANSLATORS: HUD line: the character you are driving and what they read. Format: %s, %s.
msgid "ui.slice.line.you"
msgstr "Tu conduis : %s — il lit %s"

#. TRANSLATORS: HUD line: the companion and what they read. Format: %s, %s.
msgid "ui.slice.line.companion"
msgstr "Compagnon : %s — il lit %s"

#. TRANSLATORS: HUD line: whether Sancho has the second sight. Format: %s.
msgid "ui.slice.line.second_sight"
msgstr "Seconde vue : %s"

#. TRANSLATORS: HUD line: Quixote's madness. Format: %d, %s.
msgid "ui.slice.line.locura"
msgstr "Folie de Don Quichotte : %d (%s)"

#. TRANSLATORS: HUD line: one object and what each character calls it. Format: %s, %s, %s, %s, %s.
msgid "ui.slice.line.object"
msgstr "%s — %s : %s · %s : %s"

#. TRANSLATORS: Control hint, line 1.
msgid "ui.slice.help.1"
msgstr "ZQSD/WASD marcher · Maj courir · Espace esquiver"

#. TRANSLATORS: Control hint, line 2.
msgid "ui.slice.help.2"
msgstr "TAB changer de compagnon · T la vérité du monde"

#. TRANSLATORS: Control hint, line 3.
msgid "ui.slice.help.3"
msgstr "V seconde vue · L Folie · F1 cette aide · F2 les étiquettes"

#. TRANSLATORS: The Reality layer: what actually happened.
msgid "ui.layer.reality"
msgstr "Réalité"

#. TRANSLATORS: The Book layer: what the novel says.
msgid "ui.layer.book"
msgstr "Livre"

#. TRANSLATORS: The word "on", for a switch.
msgid "ui.on"
msgstr "oui"

#. TRANSLATORS: The word "off", for a switch.
msgid "ui.off"
msgstr "non"

#. TRANSLATORS: The lowest madness band: Lucid.
msgid "ui.locura.lucid"
msgstr "Lucide"

#. TRANSLATORS: Madness band 2: Displaced.
msgid "ui.locura.displaced"
msgstr "Déplacé"

#. TRANSLATORS: Madness band 3: Lost.
msgid "ui.locura.lost"
msgstr "Perdu"

#. TRANSLATORS: Madness band 4: Absorbed.
msgid "ui.locura.absorbed"
msgstr "Absorbé"

#. TRANSLATORS: What the windmill is called in the Reality layer.
msgid "ui.form.molino"
msgstr "moulin"

#. TRANSLATORS: What the windmill is called in the Book layer.
msgid "ui.form.gigante"
msgstr "géant"

#. TRANSLATORS: What the rock is called in the Reality layer.
msgid "ui.form.roca"
msgstr "roche"

#. TRANSLATORS: What the rock is called in the Book layer.
msgid "ui.form.libro"
msgstr "livre"

#. TRANSLATORS: The windmill itself.
msgid "ui.object.molino"
msgstr "Le moulin"

#. TRANSLATORS: The rock itself.
msgid "ui.object.roca"
msgstr "Le rocher"

#. TRANSLATORS: Floating tag over an object: who is looking, and what they see. Format: %s, %s.
msgid "ui.perception.tag"
msgstr "%s : %s"

#. TRANSLATORS: Control hint, line 4.
msgid "ui.slice.help.4"
msgstr "E examiner ce que vous avez devant vous"

#. TRANSLATORS: Control hint, line 5: where the practice yard is.
msgid "ui.slice.help.5"
msgstr "À l'ouest : la cour et le mannequin · M verrouiller · K pour remettre"

#. TRANSLATORS: HUD line: the training dummy and how much of it is left. Format: %d, %d.
msgid "ui.slice.line.dummy"
msgstr "Mannequin : %d/%d"

#. TRANSLATORS: Shown when a character goes down in the practice yard.
msgid "ui.slice.down"
msgstr "Vous êtes à terre. Appuyez sur K pour vous relever."

#. TRANSLATORS: HUD line: what the player is locked onto. Format: %s.
msgid "ui.slice.line.locked"
msgstr "Verrouillé sur : %s"

#. TRANSLATORS: The marker over a locked target.
msgid "ui.lockon.marker"
msgstr "VERROUILLÉ"

#. TRANSLATORS: The training dummy, as the HUD and the lock-on call it.
msgid "ui.target.dummy"
msgstr "le mannequin d'entraînement"

#. TRANSLATORS: The name of the light attack.
msgid "it.ability.attack_light.name"
msgstr "Attaque légère"

#. TRANSLATORS: The name of the heavy attack.
msgid "it.ability.attack_heavy.name"
msgstr "Attaque lourde"

#. TRANSLATORS: The Examine prompt: what to press to look at a thing.
msgid "ui.examine.prompt"
msgstr "E — Examiner"

#. TRANSLATORS: The Examine panel: the text written on the thing, in
#. quotation marks. Format: %s.
msgid "ui.examine.quote"
msgstr "« %s »"

# --- THE FACES: what a character perceives -------------------------------
# One face per truth, per object. The Examine panel shows ONE of them —
# the one the reader is reading right now — and never the other truth and
# never the other character's reading.
#
# The "tell" is the seam: the one detail that does not add up. It is the
# seed of the Lectura system (GDD.md §6), and it is the only thing the
# player is meant to notice without a marker.

#. TRANSLATORS: The rock in the Reality truth: how it looks.
msgid "ui.face.rock.reality.desc"
msgstr "Une pierre grise de la taille d'un poing, avec du lichen sec sur le dessus et sa base enfoncée dans la terre."

#. TRANSLATORS: The rock in the Reality truth: the one detail that does not add up.
msgid "ui.face.rock.reality.tell"
msgstr "Elle pèse plus lourd qu'une pierre de cette taille ne le devrait."

#. TRANSLATORS: The rock in the Book truth: how it looks.
msgid "ui.face.rock.book.desc"
msgstr "Un petit livre, relié de cuir brun et sanglé d'une courroie. Les tranches des pages sont dorées et vous tachent les doigts."

#. TRANSLATORS: The rock in the Book truth: the one detail that does not add up.
msgid "ui.face.rock.book.tell"
msgstr "Il pèse plus lourd qu'un livre de cette taille ne le devrait."

#. TRANSLATORS: The title written on the cover of the book the rock is.
msgid "ui.face.rock.book.title"
msgstr "Le gentilhomme ingenieux Don Quichotte de la Manche"

#. TRANSLATORS: The windmill in the Reality truth: how it looks.
msgid "ui.face.windmill.reality.desc"
msgstr "Un moulin de pierre, les quatre ailes déployées et une porte basse, si usée que la charnière ne ferme plus."

#. TRANSLATORS: The windmill in the Reality truth: the one detail that does not add up.
msgid "ui.face.windmill.reality.tell"
msgstr "Il ne souffle aucun vent, et pourtant les ailes tournent."

#. TRANSLATORS: The windmill in the Book truth: how it looks.
msgid "ui.face.windmill.book.desc"
msgstr "Un géant de ceux dont on fait les contes, avec des bras si longs qu'ils frôlent le sol et une petite tête enfoncée entre les épaules."

#. TRANSLATORS: The windmill in the Book truth: the one detail that does not add up.
msgid "ui.face.windmill.book.tell"
msgstr "Ce qui ressemble à un bras sur lui est une aile de moulin."
