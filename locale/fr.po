#. META: namespace=ui
msgid "ui.book.libro.mio_cid.name"
msgstr "The Song of My Cid"

#. META: namespace=ui
msgid "ui.book.libro.mio_cid.desc"
msgstr "The Cid's exile, his two horses, and the betrayal that returns him to glory."

#. META: namespace=ui
msgid "ui.book.libro.mio_cid.passive.name"
msgstr "The Oath"

#. META: namespace=ui
msgid "ui.book.libro.mio_cid.passive.desc"
msgstr "Enemies hesitate while you hold your ground."

#. META: namespace=ui
msgid "ui.book.libro.mio_cid.codex"
msgstr "The Cid still rides through the lands he won back."

#. META: namespace=ui
msgid "ui.book.libro.pelayo.name"
msgstr "The Chronicle of Pelayo"

#. META: namespace=ui
msgid "ui.book.libro.pelayo.desc"
msgstr "Covadonga and the cave that floods the mountain: the first written triumph."

#. META: namespace=ui
msgid "ui.book.libro.pelayo.passive.name"
msgstr "The Rock"

#. META: namespace=ui
msgid "ui.book.libro.pelayo.passive.desc"
msgstr "A thrown stone staggers a whole group."

#. META: namespace=ui
msgid "ui.book.libro.pelayo.codex"
msgstr "The rock of Covadonga still stands."

#. META: namespace=ui
msgid "ui.book.libro.gatos.name"
msgstr "The Book of Cats"

#. META: namespace=ui
msgid "ui.book.libro.gatos.desc"
msgstr "A bestiary where the animals give advice, rather than advice about animals."

#. META: namespace=ui
msgid "ui.book.libro.gatos.passive.name"
msgstr "Agility"

#. META: namespace=ui
msgid "ui.book.libro.gatos.passive.desc"
msgstr "You dodge farther and for longer."

#. META: namespace=ui
msgid "ui.book.libro.gatos.codex"
msgstr "The cat watches from the shelf of memory."

#. META: namespace=ui
msgid "ui.book.libro.santo_domingo.name"
msgstr "Life of Santo Domingo de Silos"

#. META: namespace=ui
msgid "ui.book.libro.santo_domingo.desc"
msgstr "The miracle of the illuminated manuscript: ink as a form of patience."

#. META: namespace=ui
msgid "ui.book.libro.santo_domingo.passive.name"
msgstr "The Ink"

#. META: namespace=ui
msgid "ui.book.libro.santo_domingo.passive.desc"
msgstr "Madness drains slowly while it is equipped."

#. META: namespace=ui
msgid "ui.book.libro.santo_domingo.codex"
msgstr "The ink never dries: it is always writing."

#. META: namespace=ui
msgid "ui.book.libro.calila_dimna.name"
msgstr "Calila and Dimna"

#. META: namespace=ui
msgid "ui.book.libro.calila_dimna.desc"
msgstr "The lion and the ox, the king's ring: Arabic tales translated in Toledo."

#. META: namespace=ui
msgid "ui.book.libro.calila_dimna.passive.name"
msgstr "Cunning"

#. META: namespace=ui
msgid "ui.book.libro.calila_dimna.passive.desc"
msgstr "Your strikes weakening those around the enemy."

#. META: namespace=ui
msgid "ui.book.libro.calila_dimna.codex"
msgstr "The king's ring still turns in the palm of memory."

#. META: namespace=ui
msgid "ui.book.libro.milagros.name"
msgstr "The Book of Miracles"

#. META: namespace=ui
msgid "ui.book.libro.milagros.desc"
