#. META: namespace=ui
msgid "ui.book.libro.buscon.passive.name"
msgstr "The Raid"

#. META: namespace=ui
msgid "ui.book.libro.buscon.passive.desc"
msgstr "More spoils and more memories from every Venture."

#. META: namespace=ui
msgid "ui.book.libro.buscon.codex"
msgstr "The Swindler laughs at hell itself."

