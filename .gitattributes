# ─────────────────────────────────────────────────────────────────────────
#  Line endings
#
#  Normalize everything to LF in the repository, and let Git convert on
#  checkout per platform. Without this, Windows contributes CRLF to every
#  diff and the repo fills with whitespace-only noise. The LFS rules below
#  carry `-text`, so they override this for binary assets.
# ─────────────────────────────────────────────────────────────────────────

* text=auto eol=lf

# ─────────────────────────────────────────────────────────────────────────
#  Git LFS — binary asset formats
#
#  Rule: anything the editor cannot meaningfully diff goes to LFS.
#  Everything else (GDScript, .tscn, .tres, .import, .po, .md) stays plain
#  text so diffs and merges keep working.
#
#  NOTE: *.import files are deliberately NOT LFS-tracked. They are small
#  text files that hold the import presets — committing them as text is
#  what makes a fresh clone on a new machine import identically.
# ─────────────────────────────────────────────────────────────────────────
# 3D sources and exchanges
*.blend filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.abc filter=lfs diff=lfs merge=lfs -text
*.usd filter=lfs diff=lfs merge=lfs -text
*.usdz filter=lfs diff=lfs merge=lfs -text
# Textures
