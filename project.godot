[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=Array[String](["res://locale/en.po", "res://locale/es.po", "res://locale/fr.po"])
locale/fallback="es"

[layer_names]

2d_physics/layer_1="world"
3d_physics/layer_1="world"
2d_physics/layer_2="player"
3d_physics/layer_2="player"
2d_physics/layer_3="enemy"
3d_physics/layer_3="enemy"
2d_physics/layer_4="interactable"
3d_physics/layer_4="interactable"
3d_physics/layer_5="mount"

[physics]

3d/default_gravity=18.0

[rendering]

anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.086, 0.078, 0.063, 1)

[shader_globals]

truth_layer={
"type": "float",
"value": 0.0
}
ink_amount={
"type": "float",
"value": 0.0
}
layer_blend_speed={
"type": "float",
"value": 1.0
}
